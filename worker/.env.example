# ── Compliance DVN worker configuration ─────────────────────────────────────
# Copy to .env (gitignored) and fill in. The worker validates every value at boot
# and refuses to start with an aggregated error if anything is missing/malformed.

# REQUIRED — signer key for submitVerification/commitVerification (0x + 64 hex).
PRIVATE_KEY=

# REQUIRED per enabled chain — the deployed ComplianceDVN address (0x + 40 hex).
DVN_BASE_SEPOLIA=
DVN_OPTIMISM_SEPOLIA=

# Optional RPC overrides (sensible public defaults are used if unset).
RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
RPC_URL_OPTIMISM_SEPOLIA=https://sepolia.optimism.io

# Restrict the active chain set (comma-separated keys). Default: all known chains.
# CHAINS_ENABLED=baseSepolia,optimismSepolia

# ── Scanning / verification tuning ──────────────────────────────────────────
POLL_MS=15000                  # poll interval per loop iteration (ms, > 0)
DVN_CONFIRMATIONS=5            # block confirmations before acting / passed to submitVerification
SCAN_BACKFILL_BLOCKS=50        # how far back to scan on a cold checkpoint

# ── Fail-closed denylist policy ─────────────────────────────────────────────
DENYLIST_REFRESH_MS=1800000    # refresh the denylist every 30 min
MAX_DENYLIST_STALENESS_MS=3600000  # HALT (withhold all verification) if the list ages past 1 h
                                   # must be >= DENYLIST_REFRESH_MS

# ── Transaction sending ─────────────────────────────────────────────────────
TX_MAX_RETRIES=3               # bounded retries on transient send errors (0–20)
TX_GAS_BUMP_PCT=15             # gas price increase per retry attempt (%)

# ── Operational surface ─────────────────────────────────────────────────────
HTTP_PORT=9090                 # serves /healthz /readyz /metrics
LOG_LEVEL=info                 # fatal|error|warn|info|debug|trace|silent
CHECKPOINT_PATH=.context/dvn-checkpoint.json
NODE_ENV=production            # 'development' enables pretty (non-JSON) logs

# Operator-controlled flagged address for the veto demo (an address you hold the key for).
TEST_DENYLIST=
